# Aletheia — environment configuration
# Copy to `.env.local` and fill in. Never commit real values.

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# SQLite database file used by the prototype (relative to project root).
DATABASE_PATH=.data/aletheia.db

# Directory used by the local document storage adapter (relative to project root).
STORAGE_PATH=.data/uploads

# Maximum accepted upload size in bytes.
MAX_UPLOAD_BYTES=5242880

# Optional: Groq API key for AI-assisted document intelligence.
# When absent, Aletheia automatically uses the deterministic mock service.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
